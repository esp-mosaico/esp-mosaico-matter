  "dashboard": {
    "scroll": "Fixed header and viewport; content follows a vertical drag and clamps to the final row."
  },
  "camera": "Canvas resources are hidden until actual frame submission. The Monitor canvas covers the full 480 x 480 screen. Show the matching unavailable, Monitoring Off, or privacy failure layer instead of the live frame when appropriate. Raw preview is hidden in Privacy mode. Home camera cards show a Live indicator only with a real frame and a separate Monitoring Off state.",
  "states": "Slot labels initialize empty and cards hidden. Populate exactly the real catalog device name/state per slot, never fixed Light/AC/TV placeholders. Select slot controls by endpoint, not first light. Room labels are absent. Automation defaults OFF and uses real state plus automation/automation-on artwork. Family holds local names only. Face recognition and privacy processing have explicit unavailable states. Activity Log starts empty without demo records.",
  "sensors": "ldr_<variant> is complete display text such as LDR 65%; pir_<variant> is PIR Motion/No motion/--; lux mapping follows existing 0..400 lux frontend.",
  "navigation": "The Monitor menu contains Live View, Family, and Activity Log. The privacy tray opens from Live View and Select Faces has On Screen and Saved People tabs. Family Add Member has a native keyboard. Monitor root uses home_open. All callbacks include the full prefix.",
  "sliders": "Preview along the authored tracks while dragging. Commit the final value to the selected Matter endpoint on release.",
  "privacy_policy": "Requesting privacy hides raw preview across navigation and app restart until explicit Normal selection.",
  "air_conditioner": "Interactive local preview. A/C actions never reach the device manager."
}
