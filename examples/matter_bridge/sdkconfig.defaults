CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x9000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_USE_MALLOC=y
# HTTP and CLAW tasks use PSRAM stacks while accessing NVS/LittleFS.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
CONFIG_LWIP_MAX_SOCKETS=20
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_LWIP_LOCAL_HOSTNAME="matter-bridge"
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Small JSON/string allocations should also prefer PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Bound DMA buffer use instead of dynamically consuming internal RAM on TX.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y
CONFIG_LITTLEFS_MALLOC_STRATEGY_SPIRAM_PREFER=y
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_VFS_MAX_COUNT=12
CONFIG_LITTLEFS_MAX_PARTITIONS=3
CONFIG_APP_CLAW_SYSTEM_UI_ENABLE=n
CONFIG_APP_CLAW_ENABLE_CLI=n
CONFIG_APP_CLAW_CAP_LUA=y
CONFIG_APP_CLAW_CAP_IM_LOCAL=y
CONFIG_APP_CLAW_CAP_IM_QQ=y
CONFIG_APP_CLAW_CAP_IM_FEISHU=y
CONFIG_APP_CLAW_CAP_IM_TG=y
CONFIG_APP_CLAW_CAP_IM_WECHAT=y
CONFIG_APP_CLAW_CAP_SYSTEM=n
CONFIG_APP_CLAW_CAP_MCP_CLIENT=n
CONFIG_APP_CLAW_CAP_MCP_SERVER=n
CONFIG_APP_CLAW_LUA_DRIVER_ADC=n
CONFIG_APP_CLAW_LUA_DRIVER_GPIO=n
CONFIG_APP_CLAW_LUA_DRIVER_I2C=n
CONFIG_APP_CLAW_LUA_DRIVER_MCPWM=n
CONFIG_APP_CLAW_LUA_DRIVER_PCNT=n
CONFIG_APP_CLAW_LUA_DRIVER_RMT=n
CONFIG_APP_CLAW_LUA_DRIVER_TOUCH=n
CONFIG_APP_CLAW_LUA_DRIVER_UART=n
CONFIG_APP_CLAW_LUA_MODULE_BOARD_MANAGER=n
CONFIG_APP_CLAW_LUA_MODULE_AUDIO=n
CONFIG_APP_CLAW_LUA_MODULE_BLE=n
CONFIG_APP_CLAW_LUA_MODULE_BLE_HID=n
CONFIG_APP_CLAW_LUA_MODULE_CAMERA=n
CONFIG_APP_CLAW_LUA_MODULE_DISPLAY=n
CONFIG_APP_CLAW_LUA_MODULE_IMAGE=n
CONFIG_APP_CLAW_LUA_MODULE_LEDC=n
CONFIG_APP_CLAW_LUA_MODULE_LED_STRIP=n
CONFIG_APP_CLAW_LUA_MODULE_LVGL=n
CONFIG_APP_CLAW_LUA_MODULE_HTTP_SERVER=n
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# CHIPoBLE only ever advertises and serves GATT here, so drop the scanner and
# GATT-client roles NimBLE enables by default.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=2
# CHIP owns the CHIPoBLE link state; NimBLE must not retry on its own.
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_ESP_MATTER_ENABLE_MATTER_SERVER=y
CONFIG_ESP_MATTER_ENABLE_DATA_MODEL=y
CONFIG_ESP_MATTER_ENABLE_GENERATED_DATA_MODEL=n
CONFIG_ESP_MATTER_CONTROLLER_ENABLE=n
CONFIG_ESP_MATTER_COMMISSIONER_ENABLE=n
CONFIG_ENABLE_CHIP_CONTROLLER_BUILD=n
CONFIG_ESP_MATTER_ENABLE_OPENTHREAD=n
CONFIG_ENABLE_MATTER_OVER_THREAD=n
CONFIG_ENABLE_ESP32_BLE_CONTROLLER=n
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=5
CONFIG_ESP_MATTER_AGGREGATOR_ENDPOINT_COUNT=1
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_CHIP_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_CHIP_TASK_STACK_SIZE=8192
CONFIG_HTTP_REUSE_ENABLE=n
# Matter's ESP32 route hook needs these lwIP hooks to publish the fabric's
# off-link IPv6 route and default gateway.
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
