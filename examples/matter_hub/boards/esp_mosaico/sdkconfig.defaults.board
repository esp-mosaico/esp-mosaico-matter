CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n

CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y

CONFIG_APP_CLAW_LUA_DRIVER_ADC=n
CONFIG_APP_CLAW_LUA_MODULE_MAGNETOMETER=y
CONFIG_LUA_MODULE_MAGNETOMETER_CHIP_BMM150=y
CONFIG_APP_CLAW_MOSAIC_GSP_ENABLE=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
# CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY is not set
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
# CONFIG_BTDM_CTRL_MODE_BTDM is not set
CONFIG_BT_BLE_ENABLED=y
# CONFIG_BT_CLASSIC_ENABLED is not set
# CONFIG_BT_A2DP_ENABLE is not set
# CONFIG_BT_AVRCP_ENABLED is not set
# CONFIG_BT_HFP_ENABLE is not set
# CONFIG_BT_PBAC_ENABLED is not set
# CONFIG_ESP_BT_AUDIO_GMF_IO_SUPPORT is not set
CONFIG_AUDIO_DECODER_SBC_SUPPORT=y
CONFIG_AUDIO_DECODER_AAC_SUPPORT=y
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y
# CONFIG_MOSAICO_UI_BLUETOOTH_AUDIO is not set

# Client-only Matter controller: BLE commissioning, Wi-Fi operational network.
CONFIG_USE_MINIMAL_MDNS=n
CONFIG_ENABLE_EXTENDED_DISCOVERY=y
CONFIG_OPENTHREAD_SRP_CLIENT=n
CONFIG_OPENTHREAD_DNS_CLIENT=n
CONFIG_ENABLE_CHIP_CONTROLLER_BUILD=y
CONFIG_ESP_MATTER_CONTROLLER_ENABLE=y
CONFIG_ESP_MATTER_COMMISSIONER_ENABLE=y
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
# CONFIG_ESP_MATTER_ENABLE_OPENTHREAD is not set
# CONFIG_ESP_MATTER_ENABLE_MATTER_SERVER is not set
CONFIG_ENABLE_ESP32_BLE_CONTROLLER=y
# CONFIG_TEST_ATTESTATION_TRUST_STORE is not set
CONFIG_DCL_ATTESTATION_TRUST_STORE=y
CONFIG_ESP_MATTER_COMMISSIONER_SUPPORT_TEST_CD=y
CONFIG_TEST_OPERATIONAL_CREDS_ISSUER=y
CONFIG_CHIP_TASK_STACK_SIZE=15360
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_NUM_UDP_ENDPOINTS=16
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=12
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# Detachable Thread-RCP host; lifecycle belongs to thread_border_router.
CONFIG_APP_THREAD_BORDER_ROUTER_ENABLE=y
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_OPENTHREAD_RADIO_SPINEL_UART=y
CONFIG_OPENTHREAD_PLATFORM_NETIF=y
CONFIG_OPENTHREAD_BORDER_ROUTER=y
CONFIG_OPENTHREAD_TASK_SIZE=8192
CONFIG_OPENTHREAD_CONSOLE_ENABLE=n
# IDF's border-router library owns the IPv6 route hooks.
CONFIG_ENABLE_ROUTE_HOOK=n
CONFIG_LWIP_IPV6_FORWARD=y
CONFIG_LWIP_NETIF_STATUS_CALLBACK=y
CONFIG_LWIP_HOOK_IP6_INPUT_CUSTOM=y
CONFIG_LWIP_HOOK_IP6_SELECT_SRC_ADDR_CUSTOM=y
CONFIG_MDNS_MULTIPLE_INSTANCE=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_ECJPAKE_C=y

# ES8311 audio codec (speaker + microphone).
# CONFIG_APP_CLAW_LUA_MODULE_AUDIO=y
# CONFIG_ESP_BOARD_PERIPH_I2S_SUPPORT=y
# CONFIG_ESP_BOARD_DEV_AUDIO_CODEC_SUPPORT=y
# CONFIG_ESP_CODEC_DEV_ES8311_USE_DEFAULT_CALIB_IN_FLASH=y

# NAND LittleFS is mounted through the spi_nand_flash block-device layers.
CONFIG_NAND_FLASH_ENABLE_BDL=y

CONFIG_TINYUSB_CDC_ENABLED=y

# Route the interactive ESP console through the native USB Serial/JTAG port.
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y
# CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_UART_NUM=-1

CONFIG_ESP_BOARD_DEV_CAMERA_SUPPORT=y
CONFIG_APP_CLAW_LUA_MODULE_CAMERA=y
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_SPI_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_USB_UVC_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_JPEG_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_H264_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_SWAP_BYTE=n

CONFIG_CAMERA_OV3640=y
CONFIG_CAMERA_OV3640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV3640_DVP_YUV422_UYVY_640X480_30FPS=y
CONFIG_CAMERA_OV3640_DVP_DEFAULT_FMT_YUV422_UYVY_640X480_30FPS=y
CONFIG_CAMERA_OV3640_DVP_IF_FORMAT_INDEX_DEFAULT=3
# Keep both CameraBoard sensor variants available to DVP autodetection.
CONFIG_CAMERA_SC101IOT=y
CONFIG_CAMERA_BUFFER_POOL_ENABLE=y
CONFIG_CAMERA_SC101IOT_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_SC101IOT_DVP_YUV422_640X480_15FPS=y
CONFIG_CAMERA_SC101IOT_DVP_YUV422_1280X720_25FPS=y
CONFIG_CAMERA_SC101IOT_DVP_DEFAULT_FMT_YUV422_1280X720_25FPS=y
CONFIG_LUA_MODULE_CAMERA_ENABLE_VFLIP=n
CONFIG_LUA_MODULE_CAMERA_ENABLE_HMIRROR=n



# The native 480x480 Mosaic/GSP UI owns the display on esp_mosaico.
CONFIG_APP_CLAW_MOSAIC_GSP_ENABLE=y
# Keep image decoding on the render task until the async decoder's
# app-switch lifetime synchronization is fixed.
CONFIG_ESP_GSP_ENABLE_ASYNC_DECODE=n
# Temporary device-side voice/UI validation: do not dispatch to Agent.
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_DISPLAY_SERVICE_PRESENT_TE_ENABLE=y
CONFIG_DISPLAY_SERVICE_PRESENT_TE_GPIO=43

CONFIG_SPI_FLASH_AUTO_SUSPEND=y
# default:
CONFIG_SPI_FLASH_SUSPEND_TSUS_VAL_US=50
# default:
CONFIG_SPI_FLASH_SUSPEND_TRS_VAL_US=50

# The upstream esp_mosaico board defaults turn these on, which pulls in
# tda-2030/esp_vision_core -> tda-2030__imlib. That vendors its own qrcode.c
# defining the same quirc_* symbols as espressif/quirc (already a direct
# mosaico_ui dependency here for wifi/wechat QR flows), so both land in the
# same link and GCC's default -fno-common turns it into a link error. Not
# used by this app yet; revisit once that upstream conflict is sorted out.
CONFIG_LUA_MODULE_VISION_COLOR_DETECT=n
CONFIG_LUA_MODULE_VISION_QRCODE_DETECT=n
